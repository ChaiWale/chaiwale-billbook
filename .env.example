# ==============================================================================
# CHAIWALE BillBook & POS Application - Environment Configuration
# Template File: billbook/.env.example
# ==============================================================================

# Central Authoritative Backend API Endpoint
NEXT_PUBLIC_BACKEND_URL=https://api.chaiwale.co.in

# BillBook POS Application URL
NEXT_PUBLIC_BILLBOOK_URL=https://bills.chaiwale.co.in

# ------------------------------------------------------------------------------
# SECURITY & BILLING ARCHITECTURE NOTICE:
# - ONLY browser-safe variables prefixed with NEXT_PUBLIC_ may be added here.
# - BillBook delegates ALL financial, tax, and inventory calculations to backend API.
# - NEVER place SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, RESEND_API_KEY,
#   or private secrets inside billbook environment variables.
# - The browser receives calculated totals and PDF storage references from backend only.
# ------------------------------------------------------------------------------
